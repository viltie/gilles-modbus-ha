      }
    },
    {
      "key": "diagnose_brennstarts_24h",
      "entity_id": "sensor.gilles_brennstarts_24h",
      "parameters": {
        "domain": "sql",
        "config": {
          "name": "Gilles Brennstarts 24h",
          "additional_options": {
            "state_class": "measurement",
            "unit_of_measurement": "Starts"
          },
          "column": "starts",
          "query": "{% set window_end = as_timestamp(now()) %}\nSELECT COUNT(*) AS starts, MAX(s.last_updated_ts) AS last_start_ts\nFROM states AS s\nINNER JOIN states AS previous ON previous.state_id = s.old_state_id\nWHERE s.metadata_id = (SELECT metadata_id FROM states_meta WHERE entity_id = 'sensor.gilles_brenn_phase_code')\nAND previous.metadata_id = s.metadata_id\nAND s.state = '1' AND previous.state = '0'\nAND s.last_updated_ts > {{ window_end - 86400 }}\nAND s.last_updated_ts <= {{ window_end }}"
        }
      },
      "tool": "ha_set_integration"
    },
    {
      "key": "diagnose_brennstart_beobachtet",
      "entity_id": "input_boolean.gilles_brennstart_beobachtet",
      "parameters": {
        "helper_type": "input_boolean",
        "name": "Gilles Brennstart beobachtet"
      }
    },
    {
      "key": "diagnose_messwerte_unplausibel",
      "entity_id": "binary_sensor.gilles_messwerte_unplausibel",
      "parameters": {
        "config": {
          "device_class": "problem",
          "next_step_id": "binary_sensor",
          "state": "{{ is_state('binary_sensor.gilles_messdaten_verfuegbar','on') and (not (-20 <= states('sensor.gilles_kesseltemperatur')|float(0) <= 120) or not (-20 <= states('sensor.gilles_abgastemperatur')|float(0) <= 400) or not (-20 <= states('sensor.gilles_rucklauftemperatur')|float(0) <= 120)) }}"
        },
        "helper_type": "template",
        "name": "Gilles Messwerte unplausibel"
      }
    },
    {
      "key": "diagnose_haeufige_brennstarts",
      "entity_id": "binary_sensor.gilles_haeufige_brennstarts",
      "parameters": {
        "config": {
          "additional_options": {
            "availability": "{{ is_number(states('sensor.gilles_brennstarts_24h')) }}"
          },
          "device_class": "problem",
          "next_step_id": "binary_sensor",
          "state": "{{ states('sensor.gilles_brennstarts_24h')|float(0) > states('input_number.gilles_brennstarts_warnschwelle')|float(10) }}"
        },
        "helper_type": "template",
        "name": "Gilles Haeufige Brennstarts"
      }
    },
    {
      "key": "diagnose_startphase_minuten",
      "entity_id": "sensor.gilles_startphase_minuten",
      "parameters": {
        "config": {
          "additional_options": {
            "availability": "{{ is_state('input_boolean.gilles_brennstart_beobachtet','on') and has_value('sensor.gilles_brenn_phase_code') }}"
          },
          "next_step_id": "sensor",
          "state": "{{ ((as_timestamp(now()) - as_timestamp(states('input_datetime.gilles_letzter_brennstart'),as_timestamp(now())))/60)|round(1) if states('sensor.gilles_brenn_phase_code') in ['1','3','5'] else 0 }}",
          "unit_of_measurement": "min"
        },
        "helper_type": "template",
        "name": "Gilles Startphase Minuten"
      }
    },
    {
      "key": "diagnose_startphase_zu_lang",
      "entity_id": "binary_sensor.gilles_startphase_zu_lang",
      "parameters": {
        "config": {
          "device_class": "problem",
          "next_step_id": "binary_sensor",
          "state": "{{ states('sensor.gilles_startphase_minuten')|float(0) > states('input_number.gilles_zuenddauer_warnschwelle')|float(20) }}"
        },
        "helper_type": "template",
        "name": "Gilles Startphase zu lang"
      }
    },
    {
      "key": "diagnose_kesseltrend_10min",
      "entity_id": "sensor.gilles_kesseltemperatur_trend_10min",
      "parameters": {
        "helper_type": "derivative",
        "name": "Gilles Kesseltemperatur Trend 10min",
        "config": {
          "source": "sensor.gilles_kesseltemperatur",
          "unit_time": "min",
          "round": 3,
          "time_window": {
            "minutes": 10
          },
          "max_sub_interval": {
            "minutes": 1
          }
        }
      }
    },
    {
      "key": "diagnose_temperaturanstieg_fehlt",
      "entity_id": "binary_sensor.gilles_temperaturanstieg_fehlt",
      "parameters": {
        "config": {
          "device_class": "problem",
          "next_step_id": "binary_sensor",
          "state": "{% set start = as_timestamp(states('input_datetime.gilles_letzter_brennstart'), none) %}\n{% set temperature = states('sensor.gilles_kesseltemperatur') | float(none) %}\n{% set baseline = states('input_number.gilles_kesseltemperatur_bei_brennstart') | float(none) %}\n{% set minimum = states('input_number.gilles_temperaturanstieg_mindestwert') | float(none) %}\n{% set rate = states('sensor.gilles_kesseltemperatur_trend_10min') | float(none) %}\n{{ is_state('input_boolean.gilles_brennstart_beobachtet', 'on')\n   and states('sensor.gilles_brenn_phase_code') in ['6', '7']\n   and is_state('binary_sensor.gilles_messdaten_verfuegbar', 'on')\n   and start is not none and as_timestamp(now()) - start > 1800\n   and temperature is not none and baseline is not none\n   and minimum is not none and rate is not none\n   and temperature - baseline < minimum\n   and rate < minimum / 30 }}",
          "additional_options": {
            "availability": "{{ not is_state('input_boolean.gilles_brennstart_beobachtet', 'on')\n   or states('sensor.gilles_brenn_phase_code') not in ['6', '7']\n   or (is_state('binary_sensor.gilles_messdaten_verfuegbar', 'on')\n       and is_number(states('sensor.gilles_kesseltemperatur'))\n       and is_number(states('input_number.gilles_kesseltemperatur_bei_brennstart'))\n       and is_number(states('input_number.gilles_temperaturanstieg_mindestwert'))\n       and is_number(states('sensor.gilles_kesseltemperatur_trend_10min'))\n       and as_timestamp(states('input_datetime.gilles_letzter_brennstart'), none) is not none) }}"
          }
        },
        "helper_type": "template",
        "name": "Gilles Temperaturanstieg fehlt"
      }
    }
  ]
}
